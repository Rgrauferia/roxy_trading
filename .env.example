# Roxy local environment template. Copy values into your local .env; never commit real secrets.

# Alpaca read-only/paper integration
# Leave these empty until you paste real paper credentials. Template values such as
# TU_KEY_PAPER/TU_SECRET_PAPER are detected as placeholders and blocked from live probes.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Legacy alias also accepted by Roxy: ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex
# Optional server-side stock stream bridge. Run tools/roxy_stock_stream_bridge.py
# as a separate service. Do not put keys in frontend code.
ROXY_STOCK_BRIDGE_URL=
ROXY_STOCK_STREAM_URL=
ROXY_STOCK_SNAPSHOT_URL=
ROXY_STOCK_ALPACA_STREAM=1
# Comma-separated exact browser origins. Wildcard is rejected.
ROXY_STOCK_STREAM_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ROXY_STOCK_BRIDGE_HOST=127.0.0.1
ROXY_STOCK_BRIDGE_TRUSTED_PROXIES=127.0.0.1

# Optional archival destinations. Local verified storage is used by default so
# a disconnected external volume cannot block the watchdog.
ROXY_OUTPUT_ARCHIVE_DIR=
ROXY_RUNTIME_BACKUP_TARGET_DIR=
ROXY_EXTERNAL_DISK_PATH=
# Optional learning sources use the OS path separator (`:` on macOS/Linux).
ROXY_VIDEO_SOURCES=
ROXY_VIDEO_ARCHIVE_DIR=
ROXY_ALPACA_PAPER_AUTOTRADE=false
ROXY_AUTOPILOT_CODE_WRITE=0

# Global live broker execution kill switch. Keep disabled unless a reviewed adapter explicitly supports it.
ROXY_ENABLE_LIVE_BROKER_EXECUTION=0

# Roxy login providers
# Google OAuth callback/authorized redirect URI:
# https://roxy-trading.onrender.com/
ROXY_PUBLIC_URL=https://roxy-trading.onrender.com
ROXY_GOOGLE_CLIENT_ID=
ROXY_GOOGLE_CLIENT_SECRET=

# Apple Sign In requires an Apple Developer Services ID plus a private key.
# Return URL / redirect URI:
# https://roxy-trading.onrender.com/
ROXY_APPLE_CLIENT_ID=
ROXY_APPLE_TEAM_ID=
ROXY_APPLE_KEY_ID=
# Paste the full PEM key in Render as a secret. Locally, quote it and use \n for line breaks.
ROXY_APPLE_PRIVATE_KEY=

# ElevenLabs Roxy Trading voice/chat assistant
# Keep ELEVENLABS_API_KEY server-side only. Never paste it into frontend code.
ELEVENLABS_AGENT_ID=agent_6101kwchebzdf91rfk9757wq0mk4
ELEVENLABS_API_KEY=
# Persisted auth circuit: avoids repeating a rejected key across rerenders/restarts.
ROXY_ELEVENLABS_AUTH_RETRY_SECONDS=21600

# Roxy Trading OpenAI brain (server-side only; never reuse Study/Home keys).
# Keep disabled until this product has its own API project/key and budget.
ROXY_TRADING_OPENAI_ENABLED=0
ROXY_TRADING_OPENAI_API_KEY=
ROXY_TRADING_LLM_PROVIDER=openai
ROXY_TRADING_OPENAI_ROUTINE_MODEL=gpt-5.6-luna
ROXY_TRADING_OPENAI_DEEP_MODEL=gpt-5.6-terra
ROXY_TRADING_OPENAI_MONTHLY_BUDGET_USD=0
ROXY_TRADING_OPENAI_MAX_CALL_USD=0.25
ROXY_TRADING_OPENAI_USAGE_DB=alerts/roxy_trading_openai_usage.sqlite
# Pricing snapshot (USD per million tokens); verify against current OpenAI
# pricing before production activation. Values remain server-side and editable.
ROXY_TRADING_OPENAI_LUNA_INPUT_USD_PER_MTOK=0.20
ROXY_TRADING_OPENAI_LUNA_OUTPUT_USD_PER_MTOK=1.20
ROXY_TRADING_OPENAI_TERRA_INPUT_USD_PER_MTOK=2.00
ROXY_TRADING_OPENAI_TERRA_OUTPUT_USD_PER_MTOK=12.00

# Roxy Crypto OpenAI brain (independent key, budget, memory and ledger).
ROXY_CRYPTO_OPENAI_ENABLED=0
ROXY_CRYPTO_OPENAI_API_KEY=
ROXY_CRYPTO_OPENAI_ROUTINE_MODEL=gpt-5.6-luna
ROXY_CRYPTO_OPENAI_DEEP_MODEL=gpt-5.6-terra
ROXY_CRYPTO_OPENAI_MONTHLY_BUDGET_USD=0
ROXY_CRYPTO_OPENAI_MAX_CALL_USD=0.25
ROXY_CRYPTO_OPENAI_USAGE_DB=alerts/roxy_crypto_openai_usage.sqlite
ROXY_CRYPTO_OPENAI_LUNA_INPUT_USD_PER_MTOK=0.20
ROXY_CRYPTO_OPENAI_LUNA_OUTPUT_USD_PER_MTOK=1.20
ROXY_CRYPTO_OPENAI_TERRA_INPUT_USD_PER_MTOK=2.00
ROXY_CRYPTO_OPENAI_TERRA_OUTPUT_USD_PER_MTOK=12.00

# Canonical local voice/state-sync service. Keep the loopback bind unless a
# reviewed HTTPS reverse proxy is in place. Remote access requires all of:
# VOICE_API_KEY, an explicit ROXY_STATE_SYNC_USERS allowlist, and HTTPS/TLS.
VOICE_API_KEY=
ROXY_STATE_SYNC_USERS=
ROXY_VOICE_BIND_HOST=127.0.0.1
ROXY_VOICE_PORT=8010
ROXY_VOICE_PUBLIC_BASE_URL=
ROXY_VOICE_TLS_TERMINATED=false

# Broker/platform credential placeholders for preview routing and vault status
CRYPTO_COM_API_KEY=
CRYPTO_COM_API_SECRET=
# Preferred Crypto.com Exchange aliases used by Roxy's external source connector.
# Public ticker/candle data does not require private keys; keep private keys server-side only.
ROXY_CRYPTOCOM_API_KEY=
ROXY_CRYPTOCOM_API_SECRET=
ROXY_CRYPTOCOM_BASE_URL=https://api.crypto.com/exchange/v1
ROXY_EXTERNAL_CONFIRMATION_ENABLED=true
ROXY_EXTERNAL_CONFIRMATION_REMOTE=
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=
SCHWAB_ACCESS_TOKEN=
SCHWAB_ACCOUNT_HASH=
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCESS_TOKEN=
WEBULL_ACCOUNT_ID=

# Robinhood is strictly preview-only in Roxy. These names are placeholders for status/vault only.
ROBINHOOD_USERNAME=
ROBINHOOD_DEVICE_TOKEN=
ROBINHOOD_ACCOUNT_ID=

# Optional premium data/alert integrations
POLYGON_API_KEY=
POLYGON_API_TOKEN=
ROXY_FINVIZ_EXPORT_URL=
ROXY_FINVIZ_AUTH_TOKEN=
TRADIER_ACCESS_TOKEN=
DISCORD_WEBHOOK_URL=
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
WEBHOOK_URL=
TRADINGVIEW_WEBHOOK_SECRET=
TRADINGVIEW_PUBLIC_WEBHOOK_URL=
ROXY_TRADINGVIEW_WIDGET_ENABLED=true
ROXY_TRADINGVIEW_LIBRARY_URL=
SMTP_HOST=
ALERT_EMAIL_TO=

# Roxy Home OpenAI (aislado: no reutilizar OPENAI_API_KEY ni claves de Study)
ROXY_HOME_OPENAI_API_KEY=
ROXY_HOME_OPENAI_ROUTINE_MODEL=gpt-5.6-luna
ROXY_HOME_OPENAI_DEEP_MODEL=gpt-5.6-terra
ROXY_HOME_MEMORY_PATH=data/roxy_home_food.json
ROXY_HOME_CONVERSATION_PATH=data/roxy_home_conversations.json
ROXY_HOME_CONVERSATION_MAX_TURNS=12
ROXY_HOME_RECIPE_LIBRARY_PATH=data/roxy_home_recipe_library.sqlite
ROXY_HOME_ACCOUNTS_PATH=data/roxy_home_accounts.json
ROXY_HOME_CALENDAR_PATH=data/roxy_home_calendar.json
ROXY_HOME_CALENDAR_SYNC_PATH=data/roxy_home_calendar_sync.json
ROXY_HOME_CALENDAR_ENCRYPTION_KEY=
ROXY_HOME_GOOGLE_CALENDAR_CLIENT_ID=
ROXY_HOME_GOOGLE_CALENDAR_CLIENT_SECRET=
ROXY_HOME_GOOGLE_CALENDAR_REDIRECT_URI=https://roxy-home.onrender.com/v1/home-calendar/google/callback
ROXY_HOME_AI_BUDGET_PATH=data/roxy_home_ai_budget.json
ROXY_HOME_AI_DAILY_REQUEST_LIMIT=100
ROXY_HOME_AI_DAILY_OUTPUT_TOKEN_LIMIT=100000
ROXY_HOME_AI_MAX_OUTPUT_TOKENS=4000
# En producción, impide servir plantillas generales: una ficha no revisada se
# investiga una vez con Terra + búsqueda web, se valida y se guarda para reutilizarla.
ROXY_HOME_REQUIRE_VERIFIED_RECIPES=1
ROXY_HOME_RECIPE_PHOTO_DIR=data/roxy_home_recipe_photos
ROXY_HOME_RECIPE_IMAGE_GENERATION_ENABLED=1
ROXY_HOME_RECIPE_IMAGE_DAILY_LIMIT=600
ROXY_HOME_RECIPE_IMAGE_QUALITY=low
ROXY_HOME_RECIPE_IMAGE_REQUEST_INTERVAL_SECONDS=12

# Roxy Home product intelligence (server-side; public facts cache, no household data)
ROXY_HOME_PRODUCT_CACHE_PATH=data/roxy_home_products.sqlite
ROXY_HOME_PRODUCT_USER_AGENT=RoxyHome/1.0 (product-support; contact: roxy@grau360.com)
ROXY_HOME_PRODUCT_TIMEOUT_SECONDS=8
ROXY_HOME_PRODUCT_CACHE_HOURS=168
# Optional private server key. Open Food Facts and CPSC work without it.
ROXY_HOME_USDA_API_KEY=

# Roxy Home official voice (server-side only; separate key and budget from Trading).
# If VOICE_ID is blank, Home reads it from the official Roxy ElevenLabs agent.
ROXY_HOME_ELEVENLABS_API_KEY=
ROXY_HOME_ELEVENLABS_AGENT_ID=agent_6101kwchebzdf91rfk9757wq0mk4
ROXY_HOME_ELEVENLABS_VOICE_ID=
ROXY_HOME_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ROXY_HOME_ELEVENLABS_CACHE_DIR=data/roxy_home_voice

# Roxy Home commerce/affiliate accounts (server-side only and separate from Trading)
ROXY_HOME_COMMERCE_PATH=data/roxy_home_commerce.json
ROXY_HOME_INSTACART_API_KEY=
ROXY_HOME_INSTACART_API_URL=https://connect.instacart.com/idp/v1/products/products_link
# Authorized discovery of nearby Instacart retailers; prices remain confirmed in Instacart.
ROXY_HOME_INSTACART_RETAILERS_URL=https://connect.instacart.com/idp/v1/retailers
ROXY_HOME_INSTACART_AFFILIATE_URL=
# Estado informativo: needs_setup, in_review, approved_needs_configuration o unavailable.
ROXY_HOME_INSTACART_AFFILIATE_STATUS=needs_setup
# Kroger Public APIs (server-side only). Prices require the member's postal code.
ROXY_HOME_KROGER_CLIENT_ID=
ROXY_HOME_KROGER_CLIENT_SECRET=
ROXY_HOME_KROGER_API_URL=https://api.kroger.com/v1
ROXY_HOME_KROGER_STATUS=needs_setup
ROXY_HOME_AMAZON_ASSOCIATE_TAG=
ROXY_HOME_AMAZON_AFFILIATE_STATUS=needs_setup
# Paste the exact approved tracking template from Impact/each affiliate.
# It must be HTTPS and contain {destination}; {query} is optional.
ROXY_HOME_WALMART_AFFILIATE_LINK_TEMPLATE=
ROXY_HOME_WALMART_AFFILIATE_STATUS=needs_setup
# Renueva catalog/trend connections. Keep every credential server-side and product-specific.
ROXY_HOME_WALMART_AFFILIATE_API_KEY=
ROXY_HOME_EBAY_CLIENT_ID=
ROXY_HOME_EBAY_CLIENT_SECRET=
ROXY_HOME_EBAY_AFFILIATE_CAMPAIGN_ID=
ROXY_HOME_EBAY_STATUS=needs_setup
ROXY_HOME_BEST_BUY_API_KEY=
ROXY_HOME_BEST_BUY_STATUS=needs_setup
ROXY_HOME_IMPACT_ACCOUNT_SID=
ROXY_HOME_IMPACT_AUTH_TOKEN=
ROXY_HOME_IMPACT_MEDIA_PROPERTY_ID=
ROXY_HOME_IMPACT_STATUS=needs_setup
ROXY_HOME_CJ_API_KEY=
ROXY_HOME_AWIN_API_TOKEN=
ROXY_HOME_AMAZON_CREATORS_CLIENT_ID=
ROXY_HOME_AMAZON_CREATORS_CLIENT_SECRET=
ROXY_HOME_PINTEREST_ACCESS_TOKEN=
ROXY_HOME_DATAFORSEO_LOGIN=
ROXY_HOME_DATAFORSEO_PASSWORD=
ROXY_HOME_TARGET_AFFILIATE_LINK_TEMPLATE=
ROXY_HOME_TARGET_AFFILIATE_STATUS=needs_setup
ROXY_HOME_THRIVE_AFFILIATE_LINK_TEMPLATE=
ROXY_HOME_THRIVE_AFFILIATE_STATUS=needs_setup
# Roxy Renueva: each approved template must be HTTPS and contain {destination}.
# Without it, the official catalog search still works but is not monetized.
ROXY_HOME_IKEA_AFFILIATE_LINK_TEMPLATE=
ROXY_HOME_IKEA_STATUS=needs_setup
ROXY_HOME_WAYFAIR_AFFILIATE_LINK_TEMPLATE=
ROXY_HOME_WAYFAIR_STATUS=needs_setup
ROXY_HOME_WEST_ELM_AFFILIATE_LINK_TEMPLATE=
ROXY_HOME_WEST_ELM_STATUS=needs_setup
ROXY_HOME_ARTICLE_AFFILIATE_LINK_TEMPLATE=
ROXY_HOME_ARTICLE_STATUS=needs_setup
# Approved server-side catalog/price aggregator. Never expose this key to the browser.
ROXY_HOME_PRICE_FEED_URL=
ROXY_HOME_PRICE_FEED_API_KEY=
ROXY_HOME_PRICE_MAX_AGE_MINUTES=180
ROXY_HOME_PRICE_TIMEOUT_SECONDS=12
ROXY_HOME_PRICE_CACHE_SECONDS=900

# Roxy Cerca: Google Maps JavaScript key created only for Roxy Home.
# This browser key is intentionally delivered to the page, so restrict it in
# Google Cloud to https://roxy-home.onrender.com/* and only Maps JavaScript API.
# Never reuse GOOGLE_MAPS_API_KEY or any key from Finanzas/Trading.
ROXY_HOME_GOOGLE_MAPS_BROWSER_KEY=
ROXY_HOME_GOOGLE_MAP_ID=
ROXY_HOME_FAMILY_PATH=data/roxy_home_family.json

# Clima de Roxy Home (solo servidor). Por defecto usa los endpoints públicos
# de Open-Meteo; para uso comercial configura el endpoint/clave autorizados
# por tu contrato con el proveedor. La clave nunca llega al navegador.
ROXY_HOME_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
ROXY_HOME_WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
ROXY_HOME_WEATHER_API_KEY=
ROXY_HOME_WEATHER_TIMEOUT_SECONDS=10
ROXY_HOME_WEATHER_CACHE_SECONDS=900

# Roxy Renueva (private room photos and Home-only OpenAI image editing)
ROXY_HOME_DESIGN_PATH=data/roxy_home_design.json
ROXY_HOME_DESIGN_IMAGE_DIR=data/roxy_home_design
# Uses ROXY_HOME_OPENAI_API_KEY and ROXY_HOME_OPENAI_DEEP_MODEL on the server.
ROXY_HOME_DESIGN_IMAGE_QUALITY=low

# Roxy Home recipe-video library (server-side only; never reuse Trading keys).
# Generation remains disabled until an explicit Home-only key and budget exist.
ROXY_HOME_VIDEO_ENABLED=0
ROXY_HOME_VIDEO_FAL_KEY=
ROXY_HOME_VIDEO_AUTO_GENERATE_MISSING_ACTIONS=0
