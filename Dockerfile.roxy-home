FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    ROXY_SHOPPING_LIST_PATH=/var/data/roxy_home/shopping_list.json \
    ROXY_HOME_ACCOUNTS_PATH=/var/data/roxy_home/accounts.json \
    ROXY_HOME_COMMERCE_PATH=/var/data/roxy_home/commerce.json \
    ROXY_HOME_RECIPE_LIBRARY_PATH=/var/data/roxy_home/recipe_library.sqlite \
    ROXY_HOME_VIDEO_LIBRARY_PATH=/var/data/roxy_home/recipe_video_library.json \
    ROXY_HOME_VIDEO_MEDIA_DIR=/var/data/roxy_home/recipe_videos

COPY requirements-roxy-home.txt ./
RUN python -m pip install --upgrade pip \
    && pip install -r requirements-roxy-home.txt

COPY roxy_os ./roxy_os
COPY tools/roxy_home_service.py ./tools/roxy_home_service.py
COPY tools/roxy_home_video_pilot.py ./tools/roxy_home_video_pilot.py
COPY assets/roxy_list.html assets/roxy_list.css assets/roxy_list_overrides.css assets/roxy_home_food.css assets/roxy_list.js assets/roxy_list_sw.js assets/roxy_avatar_icon.jpg ./assets/
COPY assets/roxy_avatar_card.jpg ./assets/roxy_avatar_card.jpg
COPY assets/roxy_avatar.jpg ./assets/roxy_avatar.jpg
COPY assets/roxy_home/products ./assets/roxy_home/products
COPY assets/roxy_home/recipes ./assets/roxy_home/recipes
COPY assets/roxy_home/recipe_categories ./assets/roxy_home/recipe_categories
COPY assets/roxy_home/home-hero-plant.png ./assets/roxy_home/home-hero-plant.png

RUN mkdir -p /var/data/roxy_home

EXPOSE 10000

CMD ["sh", "-c", "uvicorn tools.roxy_home_service:app --host 0.0.0.0 --port ${PORT:-10000} --no-access-log"]
