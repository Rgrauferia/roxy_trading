FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    ROXY_SHOPPING_LIST_PATH=/var/data/roxy_home/shopping_list.json \
    ROXY_HOME_ACCOUNTS_PATH=/var/data/roxy_home/accounts.json \
    ROXY_HOME_MEMORY_PATH=/var/data/roxy_home/home_food.json \
    ROXY_HOME_AI_BUDGET_PATH=/var/data/roxy_home/openai_budget.json \
    ROXY_HOME_CALENDAR_PATH=/var/data/roxy_home/calendar.json \
    ROXY_HOME_CALENDAR_SYNC_PATH=/var/data/roxy_home/calendar_sync.json \
    ROXY_HOME_COMMERCE_PATH=/var/data/roxy_home/commerce.json \
    ROXY_HOME_FAMILY_PATH=/var/data/roxy_home/family.json \
    ROXY_HOME_PLANTS_PATH=/var/data/roxy_home/plants.json \
    ROXY_HOME_PLANTS_IMAGE_DIR=/var/data/roxy_home/plants \
    ROXY_HOME_DESIGN_PATH=/var/data/roxy_home/design.json \
    ROXY_HOME_DESIGN_IMAGE_DIR=/var/data/roxy_home/design \
    ROXY_HOME_RECIPE_LIBRARY_PATH=/var/data/roxy_home/recipe_library.sqlite \
    ROXY_HOME_RECIPE_PHOTO_DIR=/var/data/roxy_home/recipe_photos \
    ROXY_HOME_VIDEO_LIBRARY_PATH=/var/data/roxy_home/recipe_video_library.json \
    ROXY_HOME_VIDEO_MEDIA_DIR=/var/data/roxy_home/recipe_videos

COPY requirements-roxy-home.txt ./
RUN python -m pip install --upgrade pip \
    && pip install -r requirements-roxy-home.txt

COPY roxy_os ./roxy_os
COPY tools/roxy_home_service.py ./tools/roxy_home_service.py
COPY tools/roxy_home_video_pilot.py ./tools/roxy_home_video_pilot.py
COPY assets/roxy_list.html assets/roxy_list.css assets/roxy_list_overrides.css assets/roxy_home_food.css assets/roxy_list.js assets/roxy_list_sw.js assets/roxy_privacy.html assets/roxy_privacy.css assets/roxy_avatar_icon.jpg assets/roxy_home_avatar.jpg ./assets/
COPY assets/vendor/maplibre-gl.js assets/vendor/maplibre-gl.css ./assets/vendor/
COPY assets/roxy_home_registration.js ./assets/roxy_home_registration.js
COPY assets/roxy_home_recipe_provider.js ./assets/roxy_home_recipe_provider.js
COPY assets/roxy_home_weather_renderer.js ./assets/roxy_home_weather_renderer.js
COPY assets/roxy_home_map_readiness.js ./assets/roxy_home_map_readiness.js
COPY assets/roxy_home_open_recipes.js ./assets/roxy_home_open_recipes.js
COPY assets/roxy_home_myplate_recipes.js assets/roxy_home_myplate_recipes.css ./assets/
COPY assets/roxy_fitness.js assets/roxy_fitness.css assets/roxy_fitness_catalog.js ./assets/
COPY assets/roxy_garden_guide.js assets/roxy_garden_guide.css ./assets/
COPY assets/roxy_maplibre_loader.js ./assets/
COPY data/home_fitness_catalog.json ./data/home_fitness_catalog.json
COPY assets/roxy_home/fitness ./assets/roxy_home/fitness
COPY migrations/fitness ./migrations/fitness
COPY data/home_open_recipes.json ./data/home_open_recipes.json
COPY data/home_open_recipes_es.json ./data/home_open_recipes_es.json
COPY assets/roxy_avatar_card.jpg ./assets/roxy_avatar_card.jpg
COPY assets/roxy_avatar.jpg ./assets/roxy_avatar.jpg
COPY assets/roxy_home/products ./assets/roxy_home/products
COPY assets/roxy_home/recipes ./assets/roxy_home/recipes
COPY assets/roxy_home/recipe_categories ./assets/roxy_home/recipe_categories
COPY assets/roxy_home/recipe_custom ./assets/roxy_home/recipe_custom
COPY assets/roxy_home/avatars ./assets/roxy_home/avatars
COPY assets/roxy_home/home-hero-plant.png ./assets/roxy_home/home-hero-plant.png
COPY assets/roxy_home/pet-onboarding-hero.png ./assets/roxy_home/pet-onboarding-hero.png
COPY assets/roxy_home/renueva-living-room-hero.webp ./assets/roxy_home/renueva-living-room-hero.webp
COPY assets/roxy_home/plants-soil-meter.png ./assets/roxy_home/plants-soil-meter.png

RUN mkdir -p /var/data/roxy_home

EXPOSE 10000

CMD ["sh", "-c", "uvicorn tools.roxy_home_service:app --host 0.0.0.0 --port ${PORT:-10000} --no-access-log"]
